{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker this repo is connected to in the Cloudflare
  // dashboard — a different name deploys to a *new* Worker on its own URL.
  "name": "ministry",
  "compatibility_date": "2026-08-05",

  // The site is `output: 'static'`, so there is no Worker script: Cloudflare
  // serves `dist/` directly as static assets.
  "assets": {
    "directory": "./dist"
  }
}
