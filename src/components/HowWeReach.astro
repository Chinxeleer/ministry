---
import ImageSlot from './ImageSlot.astro';

const tiles = [
  {
    id: 'reach-study',
    photo: 'Photo: Exam study session on campus',
    title: 'Study sessions & campus activities',
    note: 'Serving students in exam season and beyond',
  },
  {
    id: 'reach-connect',
    photo: 'Photo: Connect Group meeting',
    title: 'Connect Groups',
    note: 'Small communities where students find belonging',
  },
  {
    id: 'reach-leaders',
    photo: 'Photo: Student leadership meeting / Edu Initiative',
    title: 'Leadership & the Edu Initiative',
    note: 'Training students to lead on campus and after it',
  },
  {
    id: 'reach-outreach',
    photo: 'Photo: Campus activation / outreach day',
    title: 'Campus activations',
    note: 'Meeting new students out on the lawns',
  },
];
---

<section id="how-we-reach" class="section scroll-mt-4 bg-white">
  <div class="section-inner">
    <h2
      data-reveal
      class="text-[clamp(32px,5.5vw,54px)] leading-[1.12] font-bold text-navy"
    >
      How we reach students
    </h2>

    <span data-reveal data-reveal-delay="100" class="rule mt-6 mb-[18px]"></span>

    <p
      data-reveal
      data-reveal-delay="160"
      class="mb-11 max-w-[60ch] text-[clamp(15px,1.8vw,17.5px)] leading-[1.65] text-ink"
    >
      Everyday, ordinary moments carry the ministry: showing up during exams,
      opening our homes, raising student leaders.
    </p>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-[18px]">
      {
        tiles.map((tile, i) => (
          <figure
            data-reveal
            data-reveal-delay={i * 100}
            class="group relative overflow-hidden rounded-2xl aspect-4/3"
          >
            <div class="h-full w-full transition-transform duration-600 ease-out-soft group-hover:scale-105">
              <ImageSlot id={tile.id} label={tile.photo} />
            </div>
            <figcaption class="scrim pointer-events-none absolute inset-x-0 bottom-0 px-[18px] pt-11 pb-3.5">
              <p class="text-[16px] font-semibold text-white">{tile.title}</p>
              <p class="mt-0.5 text-[13px] text-white/75">{tile.note}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
