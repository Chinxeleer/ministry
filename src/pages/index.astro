---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BigPicture from '../components/BigPicture.astro';
import WhereIFitIn from '../components/WhereIFitIn.astro';
import WhyCampus from '../components/WhyCampus.astro';
import HowWeReach from '../components/HowWeReach.astro';
import Partnership from '../components/Partnership.astro';
import TheAsk from '../components/TheAsk.astro';
---

<Layout>
  <div class="w-full overflow-x-hidden bg-white">
    <Hero />
    <main>
      <BigPicture />
      <WhereIFitIn />
      <WhyCampus />
      <HowWeReach />
      <Partnership />
      <TheAsk />
    </main>
  </div>
</Layout>
