---
/**
 * ImageSlot — the Astro counterpart of the design's <image-slot> element.
 *
 * Renders a styled placeholder until a real photo exists. To fill a slot,
 * import the image and pass it as `src`; everything else stays the same:
 *
 *   import study from '../assets/study-session.jpg';
 *   <ImageSlot id="reach-study" label="…" src={study} alt="Students studying" />
 *
 * The caption hides itself on slots narrower than 180px (container query),
 * so small circular slots stay clean.
 */
import { Image } from 'astro:assets';

interface Props {
  /** Matches the design's slot id — keeps the mapping traceable. */
  id: string;
  /** Placeholder caption, e.g. "Photo: Wits students on campus". */
  label: string;
  shape?: 'rect' | 'rounded' | 'circle';
  /** Supply a real image to replace the placeholder. */
  src?: ImageMetadata;
  alt?: string;
  /** Above-the-fold slots should load eagerly. */
  eager?: boolean;
  /** Placeholder colourway — `light` for slots on white sections. */
  tone?: 'dark' | 'light';
  /**
   * CSS object-position for the cover crop, e.g. "50% 18%" to favour a face.
   * This crops in the browser — it is not Astro's `position` prop, which
   * forwards to sharp and only accepts gravity keywords.
   */
  position?: string;
  /**
   * Widest the slot ever renders, in CSS px. Small slots (an avatar, a card
   * thumbnail) should set this so Astro doesn't generate full-viewport srcsets.
   */
  maxWidth?: number;
  class?: string;
}

const {
  id,
  label,
  shape = 'rect',
  src,
  alt = '',
  eager = false,
  tone = 'dark',
  position = 'center',
  maxWidth,
  class: className = '',
} = Astro.props;

const radius =
  shape === 'circle' ? 'rounded-full' : shape === 'rounded' ? 'rounded-xl' : '';
---

<div
  data-slot={id}
  class:list={[
    '@container relative h-full w-full overflow-hidden',
    radius,
    className,
  ]}
>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        {...maxWidth
          ? { layout: 'constrained' as const, width: maxWidth }
          : { layout: 'full-width' as const }}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="h-full w-full object-cover"
        style={`object-position:${position}`}
      />
    ) : (
      <div
        class:list={[
          'slot-fill flex h-full w-full flex-col items-center justify-center gap-3 p-4 text-center',
          tone === 'dark' ? 'slot-dark' : 'slot-light',
        ]}
        role="img"
        aria-label={label}
      >
        <svg
          class="h-7 w-7 shrink-0 opacity-60"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="16" rx="2.5" />
          <circle cx="8.75" cy="9.5" r="1.6" />
          <path d="m3.5 17.5 4.8-4.6a2 2 0 0 1 2.7 0l3 2.8m0 0 1.8-1.6a2 2 0 0 1 2.7 0l2 1.9m-6.5-.3 3 2.8" />
        </svg>
        <span class="slot-label max-w-[34ch] text-[11.5px] leading-snug font-medium tracking-[0.1em] uppercase opacity-70 @max-[180px]:hidden">
          {label}
        </span>
      </div>
    )
  }
</div>

<style>
  /* Placeholder surface: soft gradient + a faint diagonal weave, so an
     unfilled slot reads as an intentional panel rather than a broken image. */
  .slot-fill {
    background-image:
      repeating-linear-gradient(
        135deg,
        var(--weave) 0 1px,
        transparent 1px 11px
      ),
      var(--wash);
  }

  .slot-dark {
    --weave: rgb(255 255 255 / 0.05);
    --wash: radial-gradient(
        120% 90% at 78% 8%,
        rgb(245 183 49 / 0.14),
        transparent 62%
      ),
      linear-gradient(150deg, #22336f 0%, #16255f 46%, #0d1633 100%);
    color: #ffffff;
  }

  .slot-light {
    --weave: rgb(20 34 92 / 0.06);
    --wash: radial-gradient(
        120% 90% at 78% 8%,
        rgb(245 183 49 / 0.2),
        transparent 62%
      ),
      linear-gradient(150deg, #eef1f9 0%, #e3e8f5 100%);
    color: #14225c;
  }
</style>
